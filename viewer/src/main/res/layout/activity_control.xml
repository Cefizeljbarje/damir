<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/status_checking"
            android:textSize="14sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/notifySwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/push_alerts" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:text="@string/push_alerts_hint"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/camera_settings"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/motionSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/motion_detection" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/motion_sensitivity"
            android:textSize="14sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sensitivitySlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:valueFrom="1"
            android:valueTo="100" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/rotation"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/rotationGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rotAuto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rotation_auto" />

            <RadioButton
                android:id="@+id/rot0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rotation_0" />

            <RadioButton
                android:id="@+id/rot90"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rotation_90" />

            <RadioButton
                android:id="@+id/rot180"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rotation_180" />

            <RadioButton
                android:id="@+id/rot270"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rotation_270" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/recording"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/recordGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/recordOff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/record_off" />

            <RadioButton
                android:id="@+id/recordMotion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/record_motion" />

            <RadioButton
                android:id="@+id/recordContinuous"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/record_continuous" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:alpha="0.7"
            android:text="@string/audio_note"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
